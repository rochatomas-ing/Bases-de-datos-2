CREATE OR REPLACE VIEW tarea10000hs AS
SELECT *  FROM tarea
WHERE max_horas > 10000

CREATE OR REPLACE VIEW tarea10000rep AS
SELECT *  FROM tarea10000hs
WHERE id_tarea LIKE '%REP%'
WITH LOCAL CHECK OPTION;

1. INSERT INTO tarea10000rep (id_tarea, nombre_tarea, min_horas, max_horas)
     VALUES ( 'MGR', 'Org Salud', 18000, 20000);
Como el id_tarea no cumple con la condicion de la vista tarea10000rep y esta si tiene WCO local, se rechaza el insert.
No aparece en ningun objeto.

2. INSERT INTO tarea10000hs (id_tarea, nombre_tarea, min_horas, max_horas)
     VALUES (  'REPA', 'Organiz Salud', 4000, 5500);
Se inserta correctamente ya que el insert es en la tabla tarea10000hs y como no tiene WCO no importa que cumpla alguna condicion.
La tupla aparecerá en tarea, pero en tarea10000hs no ya que no cumple con la condicion.

3. INSERT INTO tarea10000rep (id_tarea, nombre_tarea, min_horas, max_horas)
     VALUES ( 'CC_REP', 'Organizacion Salud', 8000, 9000);
Se inserta ya que cumple con la condicion de tarea10000rep y no necesita cumplir ninguna condicion de la vista tarea10000hs.
La tupla aparecerá en la tabla tarea unicamente ya que la vista tarea10000hs filtra esa tupla, y la tabla tarea10000rep lee de la vista tarea10000hs.

4. INSERT INTO tarea10000hs (id_tarea, nombre_tarea, min_horas, max_horas)
     VALUES (  'ROM', 'Org Salud', 10000, 12000);
Se inserta correctamente ya que tarea10000hs no tiene WCO, la tupla se verá reflejada en la tabla tarea y en la tabla tarea10000hs.
